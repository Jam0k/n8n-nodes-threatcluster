{
  "name": "Malware hash watchlist for EDR",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "name": "Every 4 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "resource": "ioc",
        "operation": "getFeed",
        "iocTypes": "hash",
        "hours": 24
      },
      "name": "Malware hashes",
      "type": "n8n-nodes-threatcluster.threatCluster",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.type }}",
              "rightValue": "sha256",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "SHA-256 only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { count: $input.all().length, list: $input.all().map(i => i.json.value).join('\\n') } }];"
      },
      "name": "One hash per line",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://your-edr.example/api/watchlists/threatcluster",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "name": "Update EDR watchlist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ]
    }
  ],
  "connections": {
    "Every 4 hours": {
      "main": [
        [
          {
            "node": "Malware hashes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Malware hashes": {
      "main": [
        [
          {
            "node": "SHA-256 only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SHA-256 only": {
      "main": [
        [
          {
            "node": "One hash per line",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One hash per line": {
      "main": [
        [
          {
            "node": "Update EDR watchlist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}